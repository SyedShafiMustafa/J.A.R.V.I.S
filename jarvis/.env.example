[TEMPLATE]
# Copy this file to ".env" and fill in your real values.
# ".env" is never committed to Git — it's where your secrets live.

# --- LLM brain ---
LLM_PROVIDER=ollama              # "ollama" (free/local) or "openai" (paid/cloud, add later)
OLLAMA_MODEL=llama3.1             # any model you've pulled with "ollama pull <name>"
OPENAI_API_KEY=                 # leave blank unless you switch LLM_PROVIDER to openai

# --- Wake word (Porcupine needs a free access key from console.picovoice.ai) ---
PICOVOICE_ACCESS_KEY=

# --- Text-to-speech ---
TTS_PROVIDER=edge                # "edge" (free) or "elevenlabs" (paid, higher quality) later
ELEVENLABS_API_KEY=

# --- Web search (optional, add later) ---
SERPAPI_KEY=

# =====================================================================
# JARVIS V2 - Dell always-on server (Phase 0+)
# =====================================================================
# Copy this whole file to ".env" on the Dell. Only the JARVIS_* keys below
# are read by the server package (jarvis/server/).

JARVIS_ENV=development            # development | production
JARVIS_ROLE=server                # server (Dell) | brain (Lenovo, later)
JARVIS_HOST=127.0.0.1             # 0.0.0.0 ONLY behind Tailscale/firewall
JARVIS_PORT=8000
JARVIS_NODE_NAME=dell-01          # any name you like, shows in /healthz
JARVIS_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Directories (default to <repo>/logs and <repo>/data if commented out):
# JARVIS_LOG_DIR=logs
# JARVIS_DATA_DIR=data
# JARVIS_DB_PATH=data/jarvis.db

# Production requires JARVIS_SECRET_KEY >= 16 characters (auth comes in Phase 1):
JARVIS_SECRET_KEY=

# UI origins allowed to call this server (comma separated):
JARVIS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Lenovo heavy-AI endpoint the server will call from Phase 1+ (planner/LLM):
JARVIS_BRAIN_URL=http://<lenovo-host-or-tailscale-ip>:11434
